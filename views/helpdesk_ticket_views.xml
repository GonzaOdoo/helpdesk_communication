<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_ticket_form_bridge" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.bridge</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button
                    name="action_create_remote_ticket"
                    type="object"
                    string="Crear ticket remoto"
                    class="oe_highlight"
                    invisible="bridge_link_id"/>
            </xpath>

            <xpath expr="//sheet" position="inside">

                <group string="Bridge">

                    <field name="bridge_link_id" readonly="1"/>

                    <field name="bridge_uuid" readonly="1"/>

                </group>

            </xpath>

        </field>

    </record>

</odoo>